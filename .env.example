# URL publique du site (utilisée dans les textes de partage et les métadonnées OpenGraph).
# Exemple Vercel : https://simulateur-bcc.vercel.app
NEXT_PUBLIC_SITE_URL=https://simulateur-bcc.vercel.app

# Sous-chemin de déploiement : vide sur Vercel, "/Simulateur-d-examen-BCC-2026" sur GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# Supabase (facultatif) : collecte des inscriptions, résultats et avis + tableau de bord /admin.
# Sans ces deux variables, l'application reste 100 % locale (localStorage).
# Supabase → Project Settings → API : « Project URL » et « Publishable key » (ou l'ancienne « anon key »).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
